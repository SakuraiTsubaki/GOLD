From: GOLD project
Subject: [PATCH] save: reserve SaveBlock3 sidecar for 16-bit BoxMon migration

Target: rh-hideout/pokeemerald-expansion
Base: 75b806a3ab57a81ff1eb6179288981f0b3cc3050

This patch reserves fixed, versioned SaveBlock3 space for metadata displaced when
GOLD widens Species and Move IDs without increasing sizeof(struct BoxPokemon).

Per persistent mon, the planned displaced metadata is 21 bits:
- tera type: 5
- evolution tracker 1: 5
- evolution tracker 2: 5
- hyper-training flags: 6

432 persistent slots * 21 bits = 9072 bits = 1134 bytes.
The sidecar header is 12 bytes, for a total of 1146 bytes.

The upstream SaveBlock3 compile-time size assertion remains authoritative and will
fail the build if optional features plus this sidecar exceed 1624 bytes.

diff --git a/include/gold_boxmon_sidecar.h b/include/gold_boxmon_sidecar.h
new file mode 100644
--- /dev/null
+++ b/include/gold_boxmon_sidecar.h
@@ -0,0 +1,42 @@
+#ifndef GUARD_GOLD_BOXMON_SIDECAR_H
+#define GUARD_GOLD_BOXMON_SIDECAR_H
+
+// GOLD Generation 10+ save migration sidecar.
+//
+// Persistent slots audited at the pinned upstream:
+//   14 PC boxes * 30 = 420
+//   party             =   6
+//   daycare           =   2
+//   fusion storage    =   4
+//                        ---
+//                        432
+//
+// The payload holds metadata that will be displaced from BoxPokemon when
+// Species and Move fields become full 16-bit values while BoxPokemon stays
+// the same size.
+
+#define GOLD_BOXMON_SIDECAR_MAGIC 0x474F4C44 // "GOLD"
+#define GOLD_BOXMON_SIDECAR_VERSION 1
+
+#define GOLD_BOXMON_PERSISTENT_SLOTS 432
+#define GOLD_BOXMON_AUX_BITS_PER_SLOT 21
+#define GOLD_BOXMON_AUX_PAYLOAD_BYTES \
+    ((GOLD_BOXMON_PERSISTENT_SLOTS * GOLD_BOXMON_AUX_BITS_PER_SLOT + 7) / 8)
+
+// Bit layout for each logical 21-bit entry.
+#define GOLD_BOXMON_AUX_TERA_SHIFT       0
+#define GOLD_BOXMON_AUX_TERA_BITS        5
+#define GOLD_BOXMON_AUX_EVO1_SHIFT       5
+#define GOLD_BOXMON_AUX_EVO1_BITS        5
+#define GOLD_BOXMON_AUX_EVO2_SHIFT      10
+#define GOLD_BOXMON_AUX_EVO2_BITS        5
+#define GOLD_BOXMON_AUX_HYPER_SHIFT     15
+#define GOLD_BOXMON_AUX_HYPER_BITS       6
+
+struct GoldBoxMonSidecar
+{
+    u32 magic;
+    u16 version;
+    u16 slotCount;
+    u16 payloadCrc;
+    u16 flags;
+    u8 payload[GOLD_BOXMON_AUX_PAYLOAD_BYTES];
+};
+
+#endif // GUARD_GOLD_BOXMON_SIDECAR_H
diff --git a/include/global.h b/include/global.h
--- a/include/global.h
+++ b/include/global.h
@@ -21,6 +21,7 @@
 #include "constants/trainer_hill.h"
 #include "constants/trainer_tower.h"
 #include "constants/items.h"
+#include "gold_boxmon_sidecar.h"
 #include "constants/moves.h"
 #include "config/save.h"
 
@@ -1268,6 +1269,7 @@ struct SaveBlock3
 #if APRICORN_TREE_COUNT > 0
     u8 apricornTrees[NUM_APRICORN_TREE_BYTES];
 #endif
+    struct GoldBoxMonSidecar goldBoxMonSidecar;
 }; /* max size 1624 bytes */
 
 extern struct SaveBlock3 *gSaveBlock3Ptr;
diff --git a/src/save.c b/src/save.c
--- a/src/save.c
+++ b/src/save.c
@@ -128,6 +128,8 @@ static void CopyFromSaveBlock3(u32, struct SaveSector *);
 
 STATIC_ASSERT(sizeof(struct SaveBlock3) <= SAVE_BLOCK_3_CHUNK_SIZE * NUM_SECTORS_PER_SLOT, SaveBlock3FreeSpace);
+STATIC_ASSERT(sizeof(struct GoldBoxMonSidecar) == 1146, GoldBoxMonSidecarSize);
+STATIC_ASSERT(GOLD_BOXMON_AUX_PAYLOAD_BYTES == 1134, GoldBoxMonSidecarPayloadSize);
 STATIC_ASSERT(sizeof(struct SaveBlock2) <= SECTOR_DATA_SIZE, SaveBlock2FreeSpace);
 STATIC_ASSERT(sizeof(struct SaveBlock1) <= SECTOR_DATA_SIZE * (SECTOR_ID_SAVEBLOCK1_END - SECTOR_ID_SAVEBLOCK1_START + 1), SaveBlock1FreeSpace);
 STATIC_ASSERT(sizeof(struct PokemonStorage) <= SECTOR_DATA_SIZE * (SECTOR_ID_PKMN_STORAGE_END - SECTOR_ID_PKMN_STORAGE_START + 1), PokemonStorageFreeSpace);
