From: GOLD project
Subject: [PATCH] save: add BoxMon sidecar packing API

Target: rh-hideout/pokeemerald-expansion
Base: 75b806a3ab57a81ff1eb6179288981f0b3cc3050

Move the sidecar to the beginning of SaveBlock3 so its packed u32/u16 header starts
at an aligned base address, then provide versioned 21-bit slot pack/unpack helpers
with a payload CRC.

diff --git a/include/gold_boxmon_sidecar.h b/include/gold_boxmon_sidecar.h
--- a/include/gold_boxmon_sidecar.h
+++ b/include/gold_boxmon_sidecar.h
@@ -33,6 +33,14 @@
 #define GOLD_BOXMON_AUX_HYPER_SHIFT     15
 #define GOLD_BOXMON_AUX_HYPER_BITS       6
 
+struct GoldBoxMonAux
+{
+    u8 teraType;
+    u8 evolutionTracker1;
+    u8 evolutionTracker2;
+    u8 hyperTraining;
+};
+
 struct GoldBoxMonSidecar
 {
     u32 magic;
@@ -43,4 +51,11 @@
     u8 payload[GOLD_BOXMON_AUX_PAYLOAD_BYTES];
 } __attribute__((packed));
 
+void GoldBoxMonSidecarInit(struct GoldBoxMonSidecar *sidecar);
+bool32 GoldBoxMonSidecarIsValid(const struct GoldBoxMonSidecar *sidecar);
+bool32 GoldBoxMonSidecarRead(const struct GoldBoxMonSidecar *sidecar, u16 slot, struct GoldBoxMonAux *aux);
+bool32 GoldBoxMonSidecarWrite(struct GoldBoxMonSidecar *sidecar, u16 slot, const struct GoldBoxMonAux *aux);
+u16 GoldBoxMonSidecarCalculateCrc(const struct GoldBoxMonSidecar *sidecar);
+void GoldBoxMonSidecarUpdateCrc(struct GoldBoxMonSidecar *sidecar);
+
 #endif // GUARD_GOLD_BOXMON_SIDECAR_H
diff --git a/include/global.h b/include/global.h
--- a/include/global.h
+++ b/include/global.h
@@ -258,5 +258,6 @@
 struct SaveBlock3
 {
+    struct GoldBoxMonSidecar goldBoxMonSidecar;
 #if OW_USE_FAKE_RTC
     struct SiiRtcInfo fakeRTC;
 #endif
@@ -273,5 +274,4 @@
 #if APRICORN_TREE_COUNT > 0
     u8 apricornTrees[NUM_APRICORN_TREE_BYTES];
 #endif
-    struct GoldBoxMonSidecar goldBoxMonSidecar;
 }; /* max size 1624 bytes */
diff --git a/src/gold_boxmon_sidecar.c b/src/gold_boxmon_sidecar.c
new file mode 100644
--- /dev/null
+++ b/src/gold_boxmon_sidecar.c
@@ -0,0 +1,119 @@
+#include "global.h"
+
+#define GOLD_AUX_TERA_MASK  0x1F
+#define GOLD_AUX_EVO_MASK   0x1F
+#define GOLD_AUX_HYPER_MASK 0x3F
+
+static u32 GoldReadBits(const u8 *data, u32 bitOffset, u32 bitCount)
+{
+    u32 value = 0;
+    u32 i;
+
+    for (i = 0; i < bitCount; i++)
+    {
+        u32 sourceBit = bitOffset + i;
+        if (data[sourceBit >> 3] & (1u << (sourceBit & 7)))
+            value |= 1u << i;
+    }
+
+    return value;
+}
+
+static void GoldWriteBits(u8 *data, u32 bitOffset, u32 bitCount, u32 value)
+{
+    u32 i;
+
+    for (i = 0; i < bitCount; i++)
+    {
+        u32 destinationBit = bitOffset + i;
+        u8 mask = 1u << (destinationBit & 7);
+
+        if (value & (1u << i))
+            data[destinationBit >> 3] |= mask;
+        else
+            data[destinationBit >> 3] &= ~mask;
+    }
+}
+
+u16 GoldBoxMonSidecarCalculateCrc(const struct GoldBoxMonSidecar *sidecar)
+{
+    u16 crc = 0xFFFF;
+    u32 i;
+    u32 bit;
+
+    for (i = 0; i < GOLD_BOXMON_AUX_PAYLOAD_BYTES; i++)
+    {
+        crc ^= (u16)sidecar->payload[i] << 8;
+        for (bit = 0; bit < 8; bit++)
+            crc = (crc & 0x8000) ? (crc << 1) ^ 0x1021 : crc << 1;
+    }
+
+    return crc;
+}
+
+void GoldBoxMonSidecarUpdateCrc(struct GoldBoxMonSidecar *sidecar)
+{
+    sidecar->payloadCrc = GoldBoxMonSidecarCalculateCrc(sidecar);
+}
+
+void GoldBoxMonSidecarInit(struct GoldBoxMonSidecar *sidecar)
+{
+    memset(sidecar, 0, sizeof(*sidecar));
+    sidecar->magic = GOLD_BOXMON_SIDECAR_MAGIC;
+    sidecar->version = GOLD_BOXMON_SIDECAR_VERSION;
+    sidecar->slotCount = GOLD_BOXMON_PERSISTENT_SLOTS;
+    GoldBoxMonSidecarUpdateCrc(sidecar);
+}
+
+bool32 GoldBoxMonSidecarIsValid(const struct GoldBoxMonSidecar *sidecar)
+{
+    return sidecar->magic == GOLD_BOXMON_SIDECAR_MAGIC
+        && sidecar->version == GOLD_BOXMON_SIDECAR_VERSION
+        && sidecar->slotCount == GOLD_BOXMON_PERSISTENT_SLOTS
+        && sidecar->payloadCrc == GoldBoxMonSidecarCalculateCrc(sidecar);
+}
+
+bool32 GoldBoxMonSidecarRead(const struct GoldBoxMonSidecar *sidecar, u16 slot, struct GoldBoxMonAux *aux)
+{
+    u32 value;
+    u32 bitOffset;
+
+    if (slot >= GOLD_BOXMON_PERSISTENT_SLOTS || !GoldBoxMonSidecarIsValid(sidecar))
+        return FALSE;
+
+    bitOffset = slot * GOLD_BOXMON_AUX_BITS_PER_SLOT;
+    value = GoldReadBits(sidecar->payload, bitOffset, GOLD_BOXMON_AUX_BITS_PER_SLOT);
+
+    aux->teraType = (value >> GOLD_BOXMON_AUX_TERA_SHIFT) & GOLD_AUX_TERA_MASK;
+    aux->evolutionTracker1 = (value >> GOLD_BOXMON_AUX_EVO1_SHIFT) & GOLD_AUX_EVO_MASK;
+    aux->evolutionTracker2 = (value >> GOLD_BOXMON_AUX_EVO2_SHIFT) & GOLD_AUX_EVO_MASK;
+    aux->hyperTraining = (value >> GOLD_BOXMON_AUX_HYPER_SHIFT) & GOLD_AUX_HYPER_MASK;
+    return TRUE;
+}
+
+bool32 GoldBoxMonSidecarWrite(struct GoldBoxMonSidecar *sidecar, u16 slot, const struct GoldBoxMonAux *aux)
+{
+    u32 value;
+    u32 bitOffset;
+
+    if (slot >= GOLD_BOXMON_PERSISTENT_SLOTS)
+        return FALSE;
+    if (aux->teraType > GOLD_AUX_TERA_MASK
+        || aux->evolutionTracker1 > GOLD_AUX_EVO_MASK
+        || aux->evolutionTracker2 > GOLD_AUX_EVO_MASK
+        || aux->hyperTraining > GOLD_AUX_HYPER_MASK)
+        return FALSE;
+
+    if (!GoldBoxMonSidecarIsValid(sidecar))
+        GoldBoxMonSidecarInit(sidecar);
+
+    value = ((u32)aux->teraType << GOLD_BOXMON_AUX_TERA_SHIFT)
+          | ((u32)aux->evolutionTracker1 << GOLD_BOXMON_AUX_EVO1_SHIFT)
+          | ((u32)aux->evolutionTracker2 << GOLD_BOXMON_AUX_EVO2_SHIFT)
+          | ((u32)aux->hyperTraining << GOLD_BOXMON_AUX_HYPER_SHIFT);
+
+    bitOffset = slot * GOLD_BOXMON_AUX_BITS_PER_SLOT;
+    GoldWriteBits(sidecar->payload, bitOffset, GOLD_BOXMON_AUX_BITS_PER_SLOT, value);
+    GoldBoxMonSidecarUpdateCrc(sidecar);
+    return TRUE;
+}
