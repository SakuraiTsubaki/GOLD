From: GOLD project
Subject: [PATCH] pokemon: widen persistent held item and ball IDs in place

Target: rh-hideout/pokeemerald-expansion
Base: 75b806a3ab57a81ff1eb6179288981f0b3cc3050

This consumes only already-unused bits in PokemonSubstruct0.
NUM_SUBSTRUCT_BYTES and sizeof(struct BoxPokemon) remain unchanged.

diff --git a/include/pokemon.h b/include/pokemon.h
--- a/include/pokemon.h
+++ b/include/pokemon.h
@@ -117,8 +117,7 @@ struct PokemonSubstruct0
 {
     enum Species species:11; // 2047 species.
     enum Type teraType:5; // 30 types.
-    enum Item heldItem:10; // 1023 items.
-    u16 unused_02:6;
+    u16 heldItem; // GOLD: full 16-bit persistent item ID; same 16-bit storage unit.
     u32 experience:21;
     u32 nickname11:8; // 11th character of nickname.
     u32 unused_04:3;
@@ -126,9 +125,8 @@ struct PokemonSubstruct0
     u8 ppBonuses;
     u8 friendship;
-    u16 pokeball:6; // 63 balls.
+    u16 pokeball:8; // GOLD: 255 balls; consumes the previous two unused bits.
     u16 nickname12:8; // 12th character of nickname.
-    u16 unused_0A:2;
 };
